# Copy to .env.local and fill in.

# Connection used by the application. With Neon or Supabase, use the pooled URL.
DATABASE_URL=postgres://user:password@localhost:5432/feedback

# Direct (non-pooled) connection, used by migrations. Optional locally:
# DATABASE_URL is used when this is not set.
DATABASE_URL_UNPOOLED=

# Secret expected by the nightly job route (/webapi/internal/refresh-stats).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Password of the back-office (/console-bo). Nobody can sign in while it is empty.
# Changing it signs everyone out.
ADMIN_PASSWORD=
